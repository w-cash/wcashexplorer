# Copy this file to .env.docker for Docker Compose development.
# RPC endpoints must be reachable from the container and must remain firewalled.
WCASH_RPC_URL=http://host.docker.internal:38232
WCASH_RPC_USERNAME=replace-me
WCASH_RPC_PASSWORD=replace-me

ZCASH_RPC_URL=http://host.docker.internal:18232
ZCASH_RPC_USERNAME=replace-me
ZCASH_RPC_PASSWORD=replace-me
ZCASH_RPC_SECONDARY_URL=http://host.docker.internal:18242
ZCASH_RPC_SECONDARY_USERNAME=replace-me
ZCASH_RPC_SECONDARY_PASSWORD=replace-me
ZCASH_PARENT_CHAIN=test
ZCASH_PARENT_GENESIS_HASH=05a60a92d99d85997cce3b87616c089f6124d7342af37106edc76126334a2c38
REQUIRE_PARENT_QUORUM=true

WCASH_NETWORK=testnet
WCASH_NETWORK_NAME=Wcash Testnet
WCASH_SYMBOL=TWC
WCASH_DECIMALS=8
WCASH_GENESIS_HASH=0271b5b0a10b2838f43cccdec9ca2f72aa72a7c103830082bac8f82f47f0593a
WCASH_TARGET_SPACING_SECONDS=75
WCASH_COINBASE_MATURITY=100
WCASH_MAX_SUPPLY_ZAT=2100000000000000
WCASH_INITIAL_SUBSIDY_ZAT=625000000
WCASH_HALVING_INTERVAL=1680000
WCASH_FIRST_HALVING_HEIGHT=1680001

PARENT_EXPLORER_BLOCK_URL=https://testnet.cipherscan.app/block/{hash}
PARENT_EXPLORER_TX_URL=https://testnet.cipherscan.app/tx/{txid}
INDEXER_POLL_INTERVAL_MS=2000
RPC_TIMEOUT_MS=15000
MAX_REORG_DEPTH=1000
EVIDENCE_REFRESH_DEPTH=100
RUN_MIGRATIONS=true
RUN_INDEXER=true
RUST_LOG=wcashexplorer=info,tower_http=info
LOG_FORMAT=json
