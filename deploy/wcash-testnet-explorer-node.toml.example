# Private Wcash Testnet observer for the explorer and future wallet backend.
# Replace the documentation-only seed below with an operator-approved Wcash
# Testnet seed. This node does not advertise or accept public P2P traffic.

[network]
network = "WcashTestnet"
listen_addr = "127.0.0.1:38233"
initial_mainnet_peers = []
initial_testnet_peers = ["seed.testnet.wcash.invalid:38233"]
cache_dir = "/srv/wcash-testnet/wcash-peers"
max_connections_per_ip = 1

[state]
cache_dir = "/srv/wcash-testnet/wcash-cache"
ephemeral = false

[rpc]
listen_addr = "127.0.0.1:38232"
lightwalletd_listen_addr = "127.0.0.1:38234"
cookie_dir = "/run/wcash-node-rpc"
enable_cookie_auth = true
debug_force_finished_sync = false

[mining]
internal_miner = false
extra_coinbase_data = "WcashTestnet"

[tracing]
filter = "info"
