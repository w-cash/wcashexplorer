#!/bin/sh
set -eu

credentials_dir=${CREDENTIALS_DIRECTORY:?systemd credential directory is unavailable}
if [ ! -r "${credentials_dir}/wcash_rpc" ]; then
    echo "required Wcash Mainnet RPC credential is unavailable" >&2
    exit 1
fi

export WCASH_RPC_COOKIE_FILE="${credentials_dir}/wcash_rpc"
exec /opt/wcashexplorer-mainnet/bin/wcashexplorer
