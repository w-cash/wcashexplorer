# Store the deployed copy at /etc/wcashexplorer/mainnet.env (root-owned, mode 0640).
# PostgreSQL peer authentication requires a dedicated wcashexplorer-mainnet role.
DATABASE_URL=postgresql:///wcashexplorer_mainnet?host=/var/run/postgresql

WCASH_EXPLORER_BIND=127.0.0.1:8081
WCASH_RPC_URL=http://127.0.0.1:48232
# The dedicated systemd unit supplies WCASH_RPC_COOKIE_FILE privately.

WCASH_NETWORK=mainnet
WCASH_NETWORK_NAME=Wcash Mainnet
WCASH_SYMBOL=WEC
WCASH_DECIMALS=8
WCASH_COINBASE_MATURITY=100
WCASH_TARGET_SPACING_SECONDS=75
WCASH_MAX_SUPPLY_ZAT=2100000000000000
WCASH_INITIAL_SUBSIDY_ZAT=625000000
WCASH_HALVING_INTERVAL=1680000
WCASH_FIRST_HALVING_HEIGHT=1680001
WCASH_GENESIS_HASH=5bae12c8662a577b04ce1591af1a137c128f0cb51018a5f1622d861d1bb6fc48

# No ZCASH_RPC_URL is set. Wcash's embedded AuxPoW proof and exact witness
# are checked locally; parent canonical-chain observation is not configured.
ZCASH_PARENT_CHAIN=main
ZCASH_PARENT_GENESIS_HASH=00040fe8ec8471911baa1db1266ea15dd06b4a8a5c453883c000b031973dce08
REQUIRE_PARENT_QUORUM=false
PARENT_EXPLORER_BLOCK_URL=
PARENT_EXPLORER_TX_URL=

RUN_INDEXER=true
RUN_MIGRATIONS=true
INDEXER_POLL_INTERVAL_MS=2000
RPC_TIMEOUT_MS=15000
MAX_REORG_DEPTH=10000
EVIDENCE_REFRESH_DEPTH=100
LOG_FORMAT=json
RUST_LOG=wcashexplorer=info,tower_http=info
